@page "/not-found"
@layout MainLayout

<PageTitle>Страница не найдена — CS2</PageTitle>

<div class="nf">
    <div class="nf-code">404</div>
    <h1>Цель не обнаружена</h1>
    <p>Страница, которую вы ищете, не существует или была перемещена.</p>
    <a href="/" class="nf-btn">Вернуться на главную</a>
</div>

<style>
    .nf {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
        gap: 0.6rem;
    }

    .nf-code {
        font-family: 'Oxanium', sans-serif;
        font-weight: 800;
        font-size: clamp(4rem, 18vw, 10rem);
        color: var(--gold);
        line-height: 1;
        text-shadow: 0 0 40px rgba(213, 168, 85, 0.5);
    }

    .nf h1 { text-transform: uppercase; }
    .nf p { color: var(--muted); }

    .nf-btn {
        margin-top: 1.4rem;
        font-family: 'Oxanium', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.85rem 1.7rem;
        border-radius: 4px;
        background: var(--gold);
        color: #201a10;
    }
</style>
